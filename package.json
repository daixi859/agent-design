{
  "name": "pi-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pi-studio/app dev",
    "server": "node packages/server/src/main.ts",
    "build": "pnpm --filter @pi-studio/app build",
    "preview": "pnpm --filter @pi-studio/app preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check:css": "node scripts/check-css-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
