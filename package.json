{
  "name": "pi-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pi-studio/app build",
    "build:preview": "pnpm build && pnpm preview",
    "check:css": "node scripts/check-css-tokens.mjs",
    "check:naming": "node scripts/check-file-naming.mjs",
    "check:sync": "node scripts/check-token-sync.mjs",
    "dev": "pnpm --filter @pi-studio/app dev",
    "dev:desktop": "pnpm --filter @pi-studio/desktop dev",
    "desktop:build": "pnpm --filter @pi-studio/app build && pnpm --filter @pi-studio/desktop run pack",
    "desktop:pack:dir": "pnpm --filter @pi-studio/app build && pnpm --filter @pi-studio/desktop run pack:dir",
    "dsh-ui": "pnpm --filter @pi-studio/dsh-ui dev",
    "preview": "pnpm --filter @pi-studio/app preview",
    "server": "node packages/server/src/main.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
